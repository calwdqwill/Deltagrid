# Copy to .env.production on the server and replace every placeholder.
# Do not commit real .env.production.

APP_NAME=DeltaGrid
DEBUG=false

# Public domain used by the reverse proxy.
PUBLIC_APP_URL=https://deltagrid.pro
CORS_ORIGINS=https://deltagrid.pro,https://www.deltagrid.pro
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-API-Version
# Optional. Leave empty when reverse proxy routes /api/v1/stream/ws on the same domain.
NEXT_PUBLIC_WS_URL=

# Generate strong values before deploy:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=replace-me

# PostgreSQL service credentials inside docker-compose.prod.yml.
POSTGRES_DB=deltagrid
POSTGRES_USER=deltagrid
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://deltagrid:replace-me@postgres:5432/deltagrid

# External providers. Leave empty only when the feature is intentionally disabled.
COINGECKO_API_KEY=
COINGLASS_API_KEY=
COINGLASS_STANDARD_API_KEY=

# Runtime tuning.
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000
