APP_NAME=DeltaGrid
DEBUG=true

# CoinGecko API key (optional for Phase 1 Demo tier)
COINGECKO_API_KEY=

# Cache
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000

# Scanner defaults
DEFAULT_FEE_BUY_PCT=0.10
DEFAULT_FEE_SELL_PCT=0.10
DEFAULT_SLIPPAGE_PCT=0.0

# Database
DATABASE_URL=sqlite:///./deltagrid.db

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
