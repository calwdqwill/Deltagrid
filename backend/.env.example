APP_NAME=DeltaGrid
DEBUG=true

# ------------------------------------------------------------------------------
# Security — REQUIRED for production (DEBUG=false)
# ------------------------------------------------------------------------------
# JWT signing key. MUST be a strong random string in production.
# Production validation requires at least 32 characters and rejects dev defaults.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Master key for Fernet encryption of exchange API credentials.
# MUST be set in production and must contain at least 32 characters.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# ------------------------------------------------------------------------------
# External API keys
# ------------------------------------------------------------------------------
# CoinGecko API key (optional for Phase 1 Demo tier)
COINGECKO_API_KEY=

# CoinGlass API keys
# Open API (legacy) — optional
COINGLASS_API_KEY=
# Standard API (Phase 7 Data Layer)
COINGLASS_STANDARD_API_KEY=

# ------------------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------------------
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000

# ------------------------------------------------------------------------------
# Scanner defaults
# ------------------------------------------------------------------------------
DEFAULT_FEE_BUY_PCT=0.10
DEFAULT_FEE_SELL_PCT=0.10
DEFAULT_SLIPPAGE_PCT=0.0

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Local PostgreSQL from docker-compose.yml:
DATABASE_URL=postgresql://deltagrid:deltagrid@127.0.0.1:5432/deltagrid
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
# Test-only SQLite fallback. DEBUG=false rejects SQLite at startup.
# DATABASE_URL=sqlite:///./deltagrid.db

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Production validation rejects wildcard origins when DEBUG=false.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-API-Version

# ------------------------------------------------------------------------------
# Local readiness checks
# ------------------------------------------------------------------------------
# Basic liveness: GET /api/v1/health
# DB + Alembic readiness: GET /api/v1/health/readiness
