# Copy to .env.preview on the preview server and replace every placeholder.
# Do not commit real .env.preview.

APP_NAME=DeltaGrid Preview
DEBUG=false

# Public preview domain. DNS/Nginx can be added after the local preview stack is healthy.
PUBLIC_APP_URL=https://preview.deltagrid.pro
CORS_ORIGINS=https://preview.deltagrid.pro
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-API-Version
NEXT_PUBLIC_WS_URL=

# Host ports bound only to 127.0.0.1 on the server.
# Production uses 8000/3001; preview uses 8001/3002.
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3002

# Generate strong values before deploy:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=replace-me

# Separate PostgreSQL credentials for preview stack.
POSTGRES_DB=deltagrid_preview
POSTGRES_USER=deltagrid_preview
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://deltagrid_preview:replace-me@postgres:5432/deltagrid_preview

# External providers. Keep empty only when preview is intentionally data-light.
COINGECKO_API_KEY=
COINGLASS_API_KEY=
COINGLASS_STANDARD_API_KEY=

# Runtime tuning.
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
BACKEND_FETCH_TIMEOUT_MS=5000
